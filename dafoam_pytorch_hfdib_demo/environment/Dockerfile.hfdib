FROM sciml-dafoam-torch:v5.0.0

COPY dafoam_pytorch_hfdib_demo/dafoam_extension/patches/0001-hfdibstatic-rect-fvsource.patch /tmp/hfdib.patch

SHELL ["/bin/bash", "-lc"]

# Apply patch + build normal + ADR
RUN source $HOME/dafoam/loadDAFoam.sh && \
    cd $HOME/dafoam/repos/dafoam && \
    [ "$(git rev-parse HEAD)" = "31433b41d1d59638b459d24f02c7f89a756848c2" ] && \
    (git apply --check /tmp/hfdib.patch 2>/dev/null && git apply /tmp/hfdib.patch || \
     git apply --reverse --check /tmp/hfdib.patch 2>/dev/null && echo "already applied" || \
     { echo "patch conflict"; exit 1; }) && \
    wmakeLnInclude src/adjoint && \
    cd src/adjoint && wmake -j 6 && cd - && \
    sed -i "s/export WM_AD_MODE=.*/export WM_AD_MODE=ADR/" $DAFOAM_ROOT_PATH/OpenFOAM/OpenFOAM-AD/etc/bashrc && \
    . $DAFOAM_ROOT_PATH/OpenFOAM/OpenFOAM-AD/etc/bashrc && \
    cd src/adjoint && wmake -j 6 && cd - && \
    strings $HOME/dafoam/OpenFOAM/sharedLibs/libDASolver.so | grep -q hfdibStaticRect && \
    strings $HOME/dafoam/OpenFOAM/sharedLibs/libDASolverADR.so | grep -q hfdibStaticRect && \
    source $HOME/venvs/dafoam-torch/bin/activate && \
    python -c "import torch, dafoam, mpi4py; print('imports OK')" && \
    sed -i 's/export WM_AD_MODE=ADR/# export WM_AD_MODE=ADR/' $DAFOAM_ROOT_PATH/OpenFOAM/OpenFOAM-AD/etc/bashrc && \
    echo "BUILD_OK"

# Write build report
RUN source $HOME/dafoam/loadDAFoam.sh && \
    COMMIT=$(git -C $HOME/dafoam/repos/dafoam rev-parse HEAD) && \
    NORM_MD5=$(md5sum $HOME/dafoam/OpenFOAM/sharedLibs/libDASolver.so | awk '{print $1}') && \
    ADR_MD5=$(md5sum $HOME/dafoam/OpenFOAM/sharedLibs/libDASolverADR.so | awk '{print $1}') && \
    echo "{\"dafoam_source_commit\":\"$COMMIT\",\"normal_lib_hash\":\"$NORM_MD5\",\"adr_lib_hash\":\"$ADR_MD5\",\"hfdib_in_normal\":true,\"hfdib_in_adr\":true}" > $HOME/hfdib_build_report.json && \
    cat $HOME/hfdib_build_report.json

USER dafoamuser
