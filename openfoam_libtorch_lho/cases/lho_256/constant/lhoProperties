FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      lhoProperties;
}

kineticScale       0.5;
potentialScale     0.5;

numberOfStates     11;

hiddenWidth        64;
hiddenLayers       3;
enforceParity      true;

baseSeed           1234;
restarts           1;

adamSteps          500;
pretrainSteps      150;
adamLearningRate   1e-3;

// True internal-iteration budget for the LBFGS polish phase (one solver
// call; the old nested loop effectively ran up to 20x this).  Higher excited
// states (5, 7, 9) need ~100 iterations to converge from the Adam endpoint;
// 20 caps out with poor overlaps.
lbfgsMaxIterations 100;
// Gate-2 raw-coefficient mode needs a larger honest LBFGS budget to converge
// (~263 closure evals; the old nested loop effectively ran up to 400).
lbfgsCoefficientMaxIterations 400;
lbfgsHistorySize   100;

logEvery           20;
epsilon            1e-30;

writeMatrices      false;

// Full dense O(N^3) validation eigensolve (set false to skip on large meshes)
computeDirectReference true;
