FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      lhoProperties;
}

kineticScale       1.0;
potentialScale     0.5;

// Pure Laplacian (-Delta) on the unit disk, Dirichlet u=0 on the rim.
potentialMode      laplacian;
omegaY             1.0;

numberOfStates     6;

hiddenWidth        64;
hiddenLayers       3;
// Parity of the disk modes does not alternate with eigen-index (e.g. state 3
// is m=0, even parity), so do not enforce index-parity here.
enforceParity      false;

baseSeed           1234;
restarts           1;

adamSteps          500;
pretrainSteps      150;
adamLearningRate   1e-3;

lbfgsMaxIterations 20;
lbfgsHistorySize   100;

logEvery           20;
epsilon            1e-30;

writeMatrices      false;
