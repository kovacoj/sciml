+/*---------------------------------------------------------------------------*\
+    DAFoam  : Discrete Adjoint with OpenFOAM  (extension: static HFDIB)
+\*---------------------------------------------------------------------------*/
+
+#include "DAFvSourceHFDIBStaticRect.H"
+#include "DAMacroFunctions.H"
+#include "fvm.H"
+#include "fvc.H"
+#include "surfaceFields.H"
+#include "IOMRFZoneListDF.H"
+#include "Pstream.H"
+#include <cmath>
+#include <algorithm>
+#include <fstream>
+
+namespace Foam
+{
+
+defineTypeNameAndDebug(DAFvSourceHFDIBStaticRect, 0);
+addToRunTimeSelectionTable(DAFvSource, DAFvSourceHFDIBStaticRect, dictionary);
+
+// * * * * * * * * * * * * * * * * Constructors  * * * * * * * * * * * * * * //
+
+DAFvSourceHFDIBStaticRect::DAFvSourceHFDIBStaticRect(
+    const word modelType,
+    const fvMesh& mesh,
+    const DAOption& daOption,
+    const DAModel& daModel,
+    const DAIndex& daIndex)
+    : DAFvSource(modelType, mesh, daOption, daModel, daIndex),
+      x0_(0.0), y0_(0.0), z0_(0.0), x1_(0.1), y1_(0.1), z1_(0.1),
+      d1Factor_(1.5), built_(false)
+{
+    const dictionary& allOptions = daOption.getAllOptions();
+    if (allOptions.subDict("fvSource").toc().size() != 0)
+    {
+        const word name = allOptions.subDict("fvSource").toc()[0];
+        const dictionary& sub = allOptions.subDict("fvSource").subDict(name);
+
+        // geometry read into PASSIVE doubles via assignValueCheckAD
+        scalarList bounds;
+        if (sub.readIfPresent("bounds", bounds) && bounds.size() == 6)
+        {
+            assignValueCheckAD(x0_, bounds[0]);
+            assignValueCheckAD(y0_, bounds[1]);
+            assignValueCheckAD(z0_, bounds[2]);
+            assignValueCheckAD(x1_, bounds[3]);
+            assignValueCheckAD(y1_, bounds[4]);
+            assignValueCheckAD(z1_, bounds[5]);
+        }
+        if (sub.found("d1Factor"))
+        {
+            scalar tmp = sub.getScalar("d1Factor");
+            assignValueCheckAD(d1Factor_, tmp);
+        }
+        writeGeometryManifest_ = sub.lookupOrDefault<label>("writeGeometryManifest", 1);
+        writeDiagnostics_ = sub.lookupOrDefault<label>("writeDiagnostics", 0);
+    }
+    Info << "DAFvSourceHFDIBStaticRect: bounds [" << x0_ << " " << y0_ << " "
+         << z0_ << " " << x1_ << " " << y1_ << " " << z1_ << "] d1Factor "
+         << d1Factor_ << endl;
+}
+
+bool DAFvSourceHFDIBStaticRect::inRect(double x, double y, double z) const
+{
+    return x >= x0_ && x <= x1_ && y >= y0_ && y <= y1_ && z >= z0_ && z <= z1_;
+}
+
+void DAFvSourceHFDIBStaticRect::rectSignedDistance(
+    double x, double y, double z, double& sig, double q[3], double nrm[3]) const
+{
+    if (inRect(x, y, z))
+    {
+        // negative inside; q = nearest face point; n points TOWARD fluid
+        double vals[6] = {x - x0_, x1_ - x, y - y0_,
+                          y1_ - y, z - z0_, z1_ - z};
+        int imin = 0;
+        for (int i = 1; i < 6; ++i)
+        {
+            if (vals[i] < vals[imin]) imin = i;
+        }
+        const double d = vals[imin];
+        q[0] = x; q[1] = y; q[2] = z;
+        nrm[0] = 0; nrm[1] = 0; nrm[2] = 0;
+        switch (imin)
+        {
+        case 0: q[0] = x0_; nrm[0] = -1; break;
+        case 1: q[0] = x1_; nrm[0] = +1; break;
+        case 2: q[1] = y0_; nrm[1] = -1; break;
+        case 3: q[1] = y1_; nrm[1] = +1; break;
+        case 4: q[2] = z0_; nrm[2] = -1; break;
+        default: q[2] = z1_; nrm[2] = +1; break;
+        }
+        sig = -d;
+        return;
+    }
+    const double qx = clampd(x, x0_, x1_);
+    const double qy = clampd(y, y0_, y1_);
+    const double qz = clampd(z, z0_, z1_);
+    q[0] = qx; q[1] = qy; q[2] = qz;
+    const double dx = x - qx, dy = y - qy, dz = z - qz;
+    const double d = std::sqrt(dx * dx + dy * dy + dz * dz);
+    if (d > 1e-15)
+    {
+        nrm[0] = dx / d; nrm[1] = dy / d; nrm[2] = dz / d;
+    }
+    else
+    {
+        nrm[0] = 0; nrm[1] = 0; nrm[2] = 0;
+    }
+    sig = d;
+}
+
+void DAFvSourceHFDIBStaticRect::buildGeometry()
+{
+    if (built_) return;
+
+    const volVectorField::Internal& C = mesh_.C();
+    const scalarField& V = mesh_.V();
+    const label nCells = mesh_.nCells();
+    const auto& cellPoints = mesh_.cellPoints();
+    const pointField& pts = mesh_.points();
+
+    lambda_.assign(nCells, 0.0);
+    chi_.assign(nCells, 0.0);
+    sigma_.assign(nCells, 0.0);
+    ifCells_.clear(); ifCoeff_.clear();
+    ifSrcCells_.clear(); ifSrcW_.clear();
+
+    // Store per-interface-cell geometry for Pass 2
+    std::vector<double> ifSurfX_, ifSurfY_, ifSurfZ_;
+    std::vector<double> ifNrmX_, ifNrmY_, ifNrmZ_;
+    std::vector<double> ifD1_, ifHEff_, ifCX_, ifCY_, ifCZ_;
+
+    // ---- Pass 1: classify all cells (lambda, chi, sigma) ----------------
+    label nSolid = 0, nIface = 0;
+    for (label cellI = 0; cellI < nCells; ++cellI)
+    {
+        double cx, cy, cz;
+        assignValueCheckAD(cx, C[cellI][0]);
+        assignValueCheckAD(cy, C[cellI][1]);
+        assignValueCheckAD(cz, C[cellI][2]);
+        double vc;
+        assignValueCheckAD(vc, V[cellI]);
+
+        double sig; double q[3]; double nrm[3];
+        rectSignedDistance(cx, cy, cz, sig, q, nrm);
+        sigma_[cellI] = sig;
+
+        const labelList& cp = cellPoints[cellI];
+        label nIn = 0;
+        for (const label pi : cp)
+        {
+            double px_, py_, pz_;
+            assignValueCheckAD(px_, pts[pi][0]);
+            assignValueCheckAD(py_, pts[pi][1]);
+            assignValueCheckAD(pz_, pts[pi][2]);
+            if (inRect(px_, py_, pz_)) ++nIn;
+        }
+        const bool mixed = (nIn > 0 && nIn < cp.size());
+        const double hEff = std::cbrt(vc);
+
+        if (!mixed)
+        {
+            lambda_[cellI] = (nIn == cp.size()) ? 1.0 : 0.0;
+        }
+        else
+        {
+            lambda_[cellI] = 0.5 * (1.0 - std::tanh(sig / hEff));
+        }
+        chi_[cellI] = std::ceil(lambda_[cellI]);
+
+        if (mixed)
+        {
+            ++nIface;
+            const double d1 = d1Factor_ * hEff;
+            ifCells_.push_back(cellI);
+            ifCoeff_.push_back(clampd(std::abs(sig) / d1, 0.0, 1.0));
+            ifSurfX_.push_back(q[0]); ifSurfY_.push_back(q[1]); ifSurfZ_.push_back(q[2]);
+            ifNrmX_.push_back(nrm[0]); ifNrmY_.push_back(nrm[1]); ifNrmZ_.push_back(nrm[2]);
+            ifD1_.push_back(d1); ifHEff_.push_back(hEff);
+            ifCX_.push_back(cx); ifCY_.push_back(cy); ifCZ_.push_back(cz);
+        }
+        if (lambda_[cellI] >= 1.0) ++nSolid;
+    }
+
+    // ---- Pass 2: construct stencils using COMPLETE chi_ array ------------
+    for (std::size_t i = 0; i < ifCells_.size(); ++i)
+    {
+        const double hEff = ifHEff_[i];
+        const double d1 = ifD1_[i];
+        const double px = ifSurfX_[i] + d1 * ifNrmX_[i];
+        const double py = ifSurfY_[i] + d1 * ifNrmY_[i];
+        const double pz = ifSurfZ_[i] + d1 * ifNrmZ_[i];
+
+        // adaptive radius search: start at 2.5h, expand up to 10h
+        std::vector<label> srcs;
+        std::vector<double> ws;
+        double wsum = 0.0;
+        for (double rMult = 2.5; rMult <= 10.0; rMult *= 2.0)
+        {
+            srcs.clear(); ws.clear(); wsum = 0.0;
+            const double rMax = rMult * hEff;
+            for (label c2 = 0; c2 < nCells; ++c2)
+            {
+                // source cells must be strictly fluid: chi == 0 (now complete)
+                if (chi_[c2] > 0.0) continue;
+                double ux_, uy_, uz_;
+                assignValueCheckAD(ux_, C[c2][0]);
+                assignValueCheckAD(uy_, C[c2][1]);
+                assignValueCheckAD(uz_, C[c2][2]);
+                const double rx = ux_ - px, ry = uy_ - py, rz = uz_ - pz;
+                const double r2 = rx * rx + ry * ry + rz * rz;
+                if (r2 > rMax * rMax) continue;
+                const double w = 1.0 / (r2 + 1e-30);
+                srcs.push_back(c2);
+                ws.push_back(w);
+                wsum += w;
+            }
+            if (!srcs.empty()) break;
+        }
+
+        if (srcs.empty())
+        {
+            FatalErrorInFunction
+                << "No fluid-side interpolation stencil for interface cell "
+                << ifCells_[i] << "\n"
+                << "  centre: (" << ifCX_[i] << " " << ifCY_[i] << " " << ifCZ_[i] << ")\n"
+                << "  surface: (" << ifSurfX_[i] << " " << ifSurfY_[i] << " " << ifSurfZ_[i] << ")\n"
+                << "  normal: (" << ifNrmX_[i] << " " << ifNrmY_[i] << " " << ifNrmZ_[i] << ")\n"
+                << "  d1: " << d1 << "\n"
+                << "  search radius exhausted at 10*hEff = " << 10.0 * hEff
+                << exit(FatalError);
+        }
+
+        for (auto& w : ws) w /= wsum;
+        ifSrcCells_.push_back(srcs);
+        ifSrcW_.push_back(ws);
+    }
+
+    // ---- consistency checks (section 1.5) ----------------------------------
+    if (nSolid == 0)
+    {
+        FatalErrorInFunction
+            << "Zero solid cells detected for rectangle bounds ["
+            << x0_ << "," << y0_ << "," << z0_ << " - "
+            << x1_ << "," << y1_ << "," << z1_ << "]"
+            << exit(FatalError);
+    }
+    if (nIface == 0)
+    {
+        FatalErrorInFunction
+            << "Zero interface cells detected — rectangle may be aligned"
+            << " with cell boundaries or too small"
+            << exit(FatalError);
+    }
+    // validate each interface stencil
+    for (std::size_t i = 0; i < ifCells_.size(); ++i)
+    {
+        if (ifSrcCells_[i].empty())
+        {
+            FatalErrorInFunction
+                << "Interface cell " << ifCells_[i]
+                << " has empty stencil (should have been caught earlier)"
+                << exit(FatalError);
+        }
+        double wsum_check = 0.0;
+        for (double w : ifSrcW_[i])
+        {
+            if (!std::isfinite(w))
+            {
+                FatalErrorInFunction
+                    << "Non-finite weight in stencil for cell "
+                    << ifCells_[i] << exit(FatalError);
+            }
+            wsum_check += w;
+        }
+        if (std::abs(wsum_check - 1.0) > 1e-12)
+        {
+            FatalErrorInFunction
+                << "Stencil weights sum to " << wsum_check
+                << " (not 1.0) for cell " << ifCells_[i]
+                << exit(FatalError);
+        }
+        if (ifCoeff_[i] < 0.0 || ifCoeff_[i] > 1.0)
+        {
+            FatalErrorInFunction
+                << "Interpolation coefficient " << ifCoeff_[i]
+                << " outside [0,1] for cell " << ifCells_[i]
+                << exit(FatalError);
+        }
+        for (label srcCell : ifSrcCells_[i])
+        {
+            if (chi_[srcCell] > 0.0)
+            {
+                FatalErrorInFunction
+                    << "Source cell " << srcCell
+                    << " is not pure fluid (chi=" << chi_[srcCell]
+                    << ") in stencil for cell " << ifCells_[i]
+                    << exit(FatalError);
+            }
+        }
+    }
+
+    Info << "DAFvSourceHFDIBStaticRect: cells " << nCells << ", solid "
+         << nSolid << ", interface stencils " << nIface << endl;
+    built_ = true;
+    writeManifest();
+}
+
+void DAFvSourceHFDIBStaticRect::writeManifest() const
+{
+    if (!writeGeometryManifest_) return;
+    if (!Pstream::master()) return;
+
+    // write to postProcessing/hfdibGeometry/
+    fileName dir = "postProcessing/hfdibGeometry";
+    Foam::mkDir(dir);
+
+    // geometry.csv with full column set
+    std::ofstream cellsOs((dir / "geometry.csv").c_str());
+    cellsOs << "cell_id,cx,cy,cz,lambda,chi,sigma,is_interface,"
+            << "surface_x,surface_y,surface_z,"
+            << "normal_x,normal_y,normal_z,"
+            << "interpolation_coefficient\n";
+
+    const volVectorField::Internal& C = mesh_.C();
+    const label nCells = mesh_.nCells();
+    std::size_t ifIdx = 0;
+    for (label c = 0; c < nCells; ++c)
+    {
+        double cx, cy, cz;
+        assignValueCheckAD(cx, C[c][0]);
+        assignValueCheckAD(cy, C[c][1]);
+        assignValueCheckAD(cz, C[c][2]);
+
+        bool isIface = false;
+        double coef = 0.0;
+        double sx = 0, sy = 0, sz = 0, nx = 0, ny = 0, nz = 0;
+
+        if (ifIdx < ifCells_.size() && ifCells_[ifIdx] == c)
+        {
+            isIface = true;
+            coef = ifCoeff_[ifIdx];
+            // surface point and normal stored per interface cell
+            // (recompute from rectSignedDistance for simplicity — passive)
+            double sig_, q_[3], n_[3];
+            rectSignedDistance(cx, cy, cz, sig_, q_, n_);
+            sx = q_[0]; sy = q_[1]; sz = q_[2];
+            nx = n_[0]; ny = n_[1]; nz = n_[2];
+            ++ifIdx;
+        }
+
+        cellsOs << c << "," << cx << "," << cy << "," << cz << ","
+                << lambda_[c] << "," << chi_[c] << "," << sigma_[c] << ","
+                << (isIface ? 1 : 0) << ","
+                << sx << "," << sy << "," << sz << ","
+                << nx << "," << ny << "," << nz << ","
+                << coef << "\n";
+    }
+    cellsOs.close();
+
+    // stencils.json
+    std::ofstream stenOs((dir / "stencils.json").c_str());
+    stenOs << "[\n";
+    for (std::size_t i = 0; i < ifCells_.size(); ++i)
+    {
+        stenOs << "  {\"cell_id\": " << ifCells_[i]
+               << ", \"source_cells\": [";
+        for (std::size_t j = 0; j < ifSrcCells_[i].size(); ++j)
+        {
+            if (j > 0) stenOs << ", ";
+            stenOs << ifSrcCells_[i][j];
+        }
+        stenOs << "], \"source_weights\": [";
+        for (std::size_t j = 0; j < ifSrcW_[i].size(); ++j)
+        {
+            if (j > 0) stenOs << ", ";
+            stenOs << ifSrcW_[i][j];
+        }
+        stenOs << "]}";
+        if (i + 1 < ifCells_.size()) stenOs << ",";
+        stenOs << "\n";
+    }
+    stenOs << "]\n";
+    stenOs.close();
+
+    Info << "DAFvSourceHFDIBStaticRect: geometry manifest written to "
+         << dir << "/{geometry.csv,stencils.json}" << endl;
+}
+
+// * * * * * * * * * * * * * * * Member Functions  * * * * * * * * * * * * * //
+
+void DAFvSourceHFDIBStaticRect::calcFvSource(volVectorField& fvSource)
+{
+    if (!built_) buildGeometry();
+
+    // ---- active fields ----------------------------------------------------
+    volVectorField& U = const_cast<volVectorField&>(
+        mesh_.thisDb().lookupObject<volVectorField>("U"));
+    volScalarField& p = const_cast<volScalarField&>(
+        mesh_.thisDb().lookupObject<volScalarField>("p"));
+    surfaceScalarField& phi = const_cast<surfaceScalarField&>(
+        mesh_.thisDb().lookupObject<surfaceScalarField>("phi"));
+    volScalarField& alphaPorosity = const_cast<volScalarField&>(
+        mesh_.thisDb().lookupObject<volScalarField>("alphaPorosity"));
+    const IOMRFZoneListDF& MRF = mesh_.thisDb().lookupObject<IOMRFZoneListDF>(
+        "MRFProperties");
+    DATurbulenceModel& daTurb =
+        const_cast<DATurbulenceModel&>(daModel_.getDATurbulenceModel());
+
+    // ---- SAME residual momentum operator as DAResidual, minus the ---------
+    // ---- fvSource / fvOptions terms (no self-reference) -------------------
+    fvVectorMatrix UEqn(
+        fvm::div(phi, U)
+        + fvm::Sp(alphaPorosity, U)
+        + MRF.DDt(U)
+        + daTurb.divDevReff(U));
+    fvVectorMatrix& UEqnR = UEqn;
+
+    // ---- imposed field ----------------------------------------------------
+    volVectorField Uib("UibHFDIB", U);
+    for (std::size_t i = 0; i < ifCells_.size(); ++i)
+    {
+        const label c = ifCells_[i];
+        vector u1(Zero);
+        for (std::size_t j = 0; j < ifSrcCells_[i].size(); ++j)
+        {
+            u1 += ifSrcW_[i][j] * U[ifSrcCells_[i][j]];
+        }
+        Uib[c] = ifCoeff_[i] * u1;
+    }
+    for (label c = 0; c < mesh_.nCells(); ++c)
+    {
+        if (lambda_[c] >= 1.0) Uib[c] = vector::zero;
+    }
+
+    // ---- fvSource = chi * ( M_h(Uib) + grad(p) ) ---------------------------
+    const volVectorField Mib = UEqnR & Uib;
+    const volVectorField gradP = fvc::grad(p);
+
+    forAll(fvSource, cellI)
+    {
+        if (chi_[cellI] > 0.0)
+        {
+            fvSource[cellI] = Mib[cellI] + gradP[cellI];
+        }
+        else
+        {
+            fvSource[cellI] = vector::zero;
+        }
+    }
+    fvSource.correctBoundaryConditions();
+
+    // ---- optional field diagnostics (section 1.7) -------------------------
+    if (writeDiagnostics_)
+    {
+        // write lambda, chi, sigma as copies (never rename live fields)
+        volScalarField lambdaField
+        (
+            IOobject("lambdaHFDIB", mesh_.time().timeName(), mesh_,
+                     IOobject::NO_READ, IOobject::AUTO_WRITE),
+            mesh_, dimensionedScalar("zero", dimless, 0)
+        );
+        volScalarField chiField
+        (
+            IOobject("chiHFDIB", mesh_.time().timeName(), mesh_,
+                     IOobject::NO_READ, IOobject::AUTO_WRITE),
+            mesh_, dimensionedScalar("zero", dimless, 0)
+        );
+        volScalarField sigmaField
+        (
+            IOobject("sigmaHFDIB", mesh_.time().timeName(), mesh_,
+                     IOobject::NO_READ, IOobject::AUTO_WRITE),
+            mesh_, dimensionedScalar("zero", dimLength, 0)
+        );
+        forAll(lambdaField, c)
+        {
+            lambdaField[c] = lambda_[c];
+            chiField[c] = chi_[c];
+            sigmaField[c] = sigma_[c];
+        }
+        lambdaField.write();
+        chiField.write();
+        sigmaField.write();
+
+        // write copies of Uib and fvSource (never rename the live fields)
+        volVectorField UibDiag
+        (
+            IOobject("UibHFDIB", mesh_.time().timeName(), mesh_,
+                     IOobject::NO_READ, IOobject::AUTO_WRITE),
+            Uib
+        );
+        UibDiag.write();
+
+        volVectorField fvSourceDiag
+        (
+            IOobject("fvSourceHFDIB", mesh_.time().timeName(), mesh_,
+                     IOobject::NO_READ, IOobject::AUTO_WRITE),
+            fvSource
+        );
+        fvSourceDiag.write();
+    }
+}
+
