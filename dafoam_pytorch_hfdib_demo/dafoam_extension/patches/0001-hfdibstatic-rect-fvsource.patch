@@ -0,0 +1,106 @@
+/*---------------------------------------------------------------------------*\
+    DAFoam  : Discrete Adjoint with OpenFOAM  (extension: static HFDIB)
+
+    Description:
+        Static immersed-boundary momentum source for a single stationary,
+        axis-aligned rectangular solid (first-order line-interpolation
+        HFDIB, stationary wall u_Gamma = 0).
+
+        Passive data (built once, all `double`, never on the AD tape):
+          lambda (0 fluid, 1 solid, smeared interface), chi = ceil(lambda),
+          signed distance, surface points/normals, interpolation coefficient
+          ds/d1 clamped to [0,1], fluid-side interpolation stencils (pure
+          fluid cells only) with IDW weights, plus a manifest export
+          (hfdibGeometry_cells.csv / hfdibGeometry_stencils.csv) consumed by
+          the Gate-G probe and later PINN feature sets.
+
+        Active data path (per residual evaluation):
+            U_ib = imposed velocity (0 in solid, linear profile at interface)
+            f_ib = chi * ( M_h(U_ib) + grad(p) )     [UEqn built w/o sources]
+            fvSource += f_ib
+\*---------------------------------------------------------------------------*/
+
+#ifndef DAFvSourceHFDIBStaticRect_H
+#define DAFvSourceHFDIBStaticRect_H
+
+#include "DAFvSource.H"
+#include "addToRunTimeSelectionTable.H"
+#include <vector>
+
+namespace Foam
+{
+
+class DAFvSourceHFDIBStaticRect
+    : public DAFvSource
+{
+
+private:
+    /// Disallow default bitwise copy construct
+    DAFvSourceHFDIBStaticRect(const DAFvSourceHFDIBStaticRect&);
+
+    /// Disallow default bitwise assignment
+    void operator=(const DAFvSourceHFDIBStaticRect&);
+
+    /// rectangle bounds (PASSIVE doubles, extracted via assignValueCheckAD)
+    double x0_, y0_, z0_, x1_, y1_, z1_;
+
+    /// fluid-side interpolation offset multiplier (PASSIVE double)
+    double d1Factor_;
+
+    /// per-cell passive geometry fields
+    std::vector<double> lambda_;   // 0 fluid, 1 solid
+    std::vector<double> chi_;      // ceil(lambda)
+    std::vector<double> sigma_;    // signed distance
+
+    /// interface-cell stencil data (parallel arrays), built once
+    std::vector<label> ifCells_;                  // interface cell ids
+    std::vector<double> ifCoeff_;                 // ds/d1 clamped to [0,1]
+    std::vector<std::vector<label>> ifSrcCells_;  // interpolation sources
+    std::vector<std::vector<double>> ifSrcW_;     // interpolation weights
+
+    bool built_;
+
+    /// optional manifest and diagnostics flags
+    bool writeGeometryManifest_;
+    bool writeDiagnostics_;
+
+    void buildGeometry();
+
+    bool inRect(double x, double y, double z) const;
+    void rectSignedDistance(double x, double y, double z,
+                            double& sig, double q[3], double nrm[3]) const;
+
+    void writeManifest() const;
+
+    static inline double clampd(double v, double lo, double hi)
+    {
+        return v < lo ? lo : (v > hi ? hi : v);
+    }
+
+public:
+    //- Runtime type information
+    TypeName("hfdibStaticRect");
+
+    // Constructors
+    DAFvSourceHFDIBStaticRect(
