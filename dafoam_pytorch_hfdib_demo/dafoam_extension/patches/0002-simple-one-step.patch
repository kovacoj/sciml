+void DASimpleFoam::solvePrimalOneStep()
+{
+    /*
+    Description:
+        Execute exactly one outer SIMPLE iteration from the current
+        state (U, p, phi already set via updateOFFields).
+    */
+
+#include "createRefsSimple.H"
+#include "createFvOptions.H"
+
+    // Update intermediate variables (turbulence, etc.)
+    daTurbulenceModelPtr_->updateIntermediateVariables();
+
+    Info << "solvePrimalOneStep: ||U||=" << mag(gAverage(U))
+         << " ||p||=" << mag(gAverage(p))
+         << " ||phi||=" << mag(gAverage(phi)) << endl;
+
+    p.storePrevIter();
+
+    // --- Pressure-velocity SIMPLE corrector
+    {
+#include "UEqnSimple.H"
+#include "pEqnSimple.H"
+    }
+
+    laminarTransport.correct();
+    daTurbulenceModelPtr_->correct(false);
+
+    Info << "solvePrimalOneStep done: ||U||=" << mag(gAverage(U))
+         << " ||p||=" << mag(gAverage(p))
+         << " ||phi||=" << mag(gAverage(phi)) << endl;
+
+    // Update the residual statistics so the AD tape is consistent
+    this->calcPrimalResidualStatistics("calc");
+}
+
