+/*---------------------------------------------------------------------------*\
+    DAFoam  : Discrete Adjoint with OpenFOAM  (extension: static HFDIB)
+\*---------------------------------------------------------------------------*/
+
+#include "DAFvSourceHFDIBStaticRect.H"
+#include "DAMacroFunctions.H"
+#include "fvm.H"
+#include "fvc.H"
+#include "surfaceFields.H"
+#include "IOMRFZoneListDF.H"
+#include "Pstream.H"
+#include <cmath>
+#include <algorithm>
+#include <fstream>
+
+namespace Foam
+{
+
+defineTypeNameAndDebug(DAFvSourceHFDIBStaticRect, 0);
+addToRunTimeSelectionTable(DAFvSource, DAFvSourceHFDIBStaticRect, dictionary);
+
+// * * * * * * * * * * * * * * * * Constructors  * * * * * * * * * * * * * * //
+
+DAFvSourceHFDIBStaticRect::DAFvSourceHFDIBStaticRect(
+    const word modelType,
+    const fvMesh& mesh,
+    const DAOption& daOption,
+    const DAModel& daModel,
+    const DAIndex& daIndex)
+    : DAFvSource(modelType, mesh, daOption, daModel, daIndex),
+      x0_(0.0), y0_(0.0), z0_(0.0), x1_(0.1), y1_(0.1), z1_(0.1),
+      d1Factor_(1.5), built_(false)
+{
+    const dictionary& allOptions = daOption.getAllOptions();
+    if (allOptions.subDict("fvSource").toc().size() != 0)
+    {
+        const word name = allOptions.subDict("fvSource").toc()[0];
+        const dictionary& sub = allOptions.subDict("fvSource").subDict(name);
+
+        // geometry read into PASSIVE doubles via assignValueCheckAD
+        scalarList bounds;
+        if (sub.readIfPresent("bounds", bounds) && bounds.size() == 6)
+        {
+            assignValueCheckAD(x0_, bounds[0]);
+            assignValueCheckAD(y0_, bounds[1]);
+            assignValueCheckAD(z0_, bounds[2]);
+            assignValueCheckAD(x1_, bounds[3]);
+            assignValueCheckAD(y1_, bounds[4]);
+            assignValueCheckAD(z1_, bounds[5]);
+        }
+        if (sub.found("d1Factor"))
+        {
+            scalar tmp = sub.getScalar("d1Factor");
+            assignValueCheckAD(d1Factor_, tmp);
+        }
+    }
+    Info << "DAFvSourceHFDIBStaticRect: bounds [" << x0_ << " " << y0_ << " "
+         << z0_ << " " << x1_ << " " << y1_ << " " << z1_ << "] d1Factor "
+         << d1Factor_ << endl;
+}
+
+bool DAFvSourceHFDIBStaticRect::inRect(double x, double y, double z) const
+{
+    return x >= x0_ && x <= x1_ && y >= y0_ && y <= y1_ && z >= z0_ && z <= z1_;
+}
+
+void DAFvSourceHFDIBStaticRect::rectSignedDistance(
+    double x, double y, double z, double& sig, double q[3], double nrm[3]) const
+{
+    if (inRect(x, y, z))
+    {
+        // negative inside; q = nearest face point; n points TOWARD fluid
+        double vals[6] = {x - x0_, x1_ - x, y - y0_,
+                          y1_ - y, z - z0_, z1_ - z};
+        int imin = 0;
+        for (int i = 1; i < 6; ++i)
+        {
+            if (vals[i] < vals[imin]) imin = i;
+        }
+        const double d = vals[imin];
+        q[0] = x; q[1] = y; q[2] = z;
+        nrm[0] = 0; nrm[1] = 0; nrm[2] = 0;
+        switch (imin)
+        {
+        case 0: q[0] = x0_; nrm[0] = -1; break;
+        case 1: q[0] = x1_; nrm[0] = +1; break;
+        case 2: q[1] = y0_; nrm[1] = -1; break;
+        case 3: q[1] = y1_; nrm[1] = +1; break;
+        case 4: q[2] = z0_; nrm[2] = -1; break;
+        default: q[2] = z1_; nrm[2] = +1; break;
+        }
+        sig = -d;
+        return;
+    }
+    const double qx = clampd(x, x0_, x1_);
+    const double qy = clampd(y, y0_, y1_);
+    const double qz = clampd(z, z0_, z1_);
+    q[0] = qx; q[1] = qy; q[2] = qz;
+    const double dx = x - qx, dy = y - qy, dz = z - qz;
+    const double d = std::sqrt(dx * dx + dy * dy + dz * dz);
+    if (d > 1e-15)
+    {
+        nrm[0] = dx / d; nrm[1] = dy / d; nrm[2] = dz / d;
+    }
+    else
+    {
+        nrm[0] = 0; nrm[1] = 0; nrm[2] = 0;
+    }
+    sig = d;
+}
+
+void DAFvSourceHFDIBStaticRect::buildGeometry()
+{
+    if (built_) return;
+
+    const volVectorField::Internal& C = mesh_.C();
+    const scalarField& V = mesh_.V();
+    const label nCells = mesh_.nCells();
+    const auto& cellPoints = mesh_.cellPoints();
+    const pointField& pts = mesh_.points();
+
+    lambda_.assign(nCells, 0.0);
+    chi_.assign(nCells, 0.0);
+    sigma_.assign(nCells, 0.0);
+    ifCells_.clear(); ifIsSolid_.clear(); ifCoeff_.clear();
+    ifSrcCells_.clear(); ifSrcW_.clear();
+
+    label nSolid = 0, nIface = 0;
+    for (label cellI = 0; cellI < nCells; ++cellI)
+    {
+        // passive extraction of the cell centre
+        double cx, cy, cz;
+        assignValueCheckAD(cx, C[cellI][0]);
+        assignValueCheckAD(cy, C[cellI][1]);
+        assignValueCheckAD(cz, C[cellI][2]);
+        double vc;
+        assignValueCheckAD(vc, V[cellI]);
+
+        double sig; double q[3]; double nrm[3];
+        rectSignedDistance(cx, cy, cz, sig, q, nrm);
+        sigma_[cellI] = sig;
+
+        const labelList& cp = cellPoints[cellI];
+        label nIn = 0;
+        for (const label pi : cp)
+        {
+            double px_, py_, pz_;
+            assignValueCheckAD(px_, pts[pi][0]);
+            assignValueCheckAD(py_, pts[pi][1]);
+            assignValueCheckAD(pz_, pts[pi][2]);
+            if (inRect(px_, py_, pz_)) ++nIn;
+        }
+        const bool mixed = (nIn > 0 && nIn < cp.size());
+        const double hEff = std::cbrt(vc);
+
+        if (!mixed)
+        {
+            lambda_[cellI] = (nIn == cp.size()) ? 1.0 : 0.0;
+        }
+        else
+        {
+            lambda_[cellI] = 0.5 * (1.0 - std::tanh(sig / hEff));
+        }
+        chi_[cellI] = std::ceil(lambda_[cellI]);
+
+        if (mixed)
+        {
+            ++nIface;
+            const double d1 = d1Factor_ * hEff;
+            ifCells_.push_back(cellI);
+            ifIsSolid_.push_back(0);
+            // coefficient ds/d1 clamped to [0, 1]
+            ifCoeff_.push_back(clampd(std::abs(sig) / d1, 0.0, 1.0));
+
+            // fluid-side interpolation point x1 = q + d1*n
+            const double px = q[0] + d1 * nrm[0];
+            const double py = q[1] + d1 * nrm[1];
+            const double pz = q[2] + d1 * nrm[2];
+
+            // IDW weights over PURE FLUID cells within 2.5*h radius
+            std::vector<label> srcs;
+            std::vector<double> ws;
+            double wsum = 0.0;
+            const double rMax = 2.5 * hEff;
+            for (label c2 = 0; c2 < nCells; ++c2)
+            {
+                // source cells must be strictly fluid-side: chi == 0
+                if (chi_[c2] > 0.0) continue;
+                double ux_, uy_, uz_;
+                assignValueCheckAD(ux_, C[c2][0]);
+                assignValueCheckAD(uy_, C[c2][1]);
+                assignValueCheckAD(uz_, C[c2][2]);
+                const double rx = ux_ - px, ry = uy_ - py, rz = uz_ - pz;
+                const double r2 = rx * rx + ry * ry + rz * rz;
+                if (r2 > rMax * rMax) continue;
+                const double w = 1.0 / (r2 + 1e-30);
+                srcs.push_back(c2);
+                ws.push_back(w);
+                wsum += w;
+            }
+            if (srcs.empty())
+            {
+                ifIsSolid_.back() = 1;
+                ifCoeff_.back() = 0.0;
+                ifSrcCells_.push_back(std::vector<label>{});
+                ifSrcW_.push_back(std::vector<double>{});
+            }
+            else
+            {
+                for (auto& w : ws) w /= wsum;
+                ifSrcCells_.push_back(srcs);
+                ifSrcW_.push_back(ws);
+            }
+        }
+        if (lambda_[cellI] >= 1.0) ++nSolid;
+    }
+
+    Info << "DAFvSourceHFDIBStaticRect: cells " << nCells << ", solid "
+         << nSolid << ", interface stencils " << nIface << endl;
+    built_ = true;
+    writeManifest();
+}
+
+void DAFvSourceHFDIBStaticRect::writeManifest() const
+{
+    if (!Pstream::master()) return;
+
+    std::ofstream cellsOs("hfdibGeometry_cells.csv");
+    cellsOs << "cell,lambda,chi,sigma,is_interface,coeff\n";
+    {
+        std::size_t i = 0;
+        for (label c = 0; c < mesh_.nCells(); ++c)
+        {
+            cellsOs << c << "," << lambda_[c] << "," << chi_[c] << ","
+                    << sigma_[c] << ",";
+            bool iface = false;
+            double coef = 0.0;
+            // interface cells are exactly the ifCells_ entries
+            if (i < ifCells_.size() && ifCells_[i] == c)
+            {
+                iface = true;
+                coef = ifCoeff_[i];
+                ++i;
+            }
+            cellsOs << (iface ? 1 : 0) << "," << coef << "\n";
+        }
+    }
+    cellsOs.close();
+
+    std::ofstream stenOs("hfdibGeometry_stencils.csv");
+    stenOs << "target,term,source,weight\n";
+    for (std::size_t i = 0; i < ifCells_.size(); ++i)
+    {
+        for (std::size_t j = 0; j < ifSrcCells_[i].size(); ++j)
+        {
+            stenOs << ifCells_[i] << "," << j << "," << ifSrcCells_[i][j]
+                   << "," << ifSrcW_[i][j] << "\n";
+        }
+    }
+    stenOs.close();
+    Info << "DAFvSourceHFDIBStaticRect: geometry manifest written to "
+            "hfdibGeometry_{cells,stencils}.csv" << endl;
+}
+
+// * * * * * * * * * * * * * * * Member Functions  * * * * * * * * * * * * * //
+
+void DAFvSourceHFDIBStaticRect::calcFvSource(volVectorField& fvSource)
+{
+    if (!built_) buildGeometry();
+
+    // ---- active fields ----------------------------------------------------
+    volVectorField& U = const_cast<volVectorField&>(
+        mesh_.thisDb().lookupObject<volVectorField>("U"));
+    volScalarField& p = const_cast<volScalarField&>(
+        mesh_.thisDb().lookupObject<volScalarField>("p"));
+    surfaceScalarField& phi = const_cast<surfaceScalarField&>(
+        mesh_.thisDb().lookupObject<surfaceScalarField>("phi"));
+    volScalarField& alphaPorosity = const_cast<volScalarField&>(
+        mesh_.thisDb().lookupObject<volScalarField>("alphaPorosity"));
+    const IOMRFZoneListDF& MRF = mesh_.thisDb().lookupObject<IOMRFZoneListDF>(
+        "MRFProperties");
+    DATurbulenceModel& daTurb =
+        const_cast<DATurbulenceModel&>(daModel_.getDATurbulenceModel());
+
+    // ---- SAME residual momentum operator as DAResidual, minus the ---------
+    // ---- fvSource / fvOptions terms (no self-reference) -------------------
+    fvVectorMatrix UEqn(
+        fvm::div(phi, U)
+        + fvm::Sp(alphaPorosity, U)
+        + MRF.DDt(U)
+        + daTurb.divDevReff(U));
+    fvVectorMatrix& UEqnR = UEqn;
+
+    // ---- imposed field ----------------------------------------------------
+    volVectorField Uib("UibHFDIB", U);
+    for (std::size_t i = 0; i < ifCells_.size(); ++i)
+    {
+        const label c = ifCells_[i];
+        if (ifIsSolid_[i])
+        {
+            Uib[c] = vector::zero;
+            continue;
+        }
+        vector u1(Zero);
+        for (std::size_t j = 0; j < ifSrcCells_[i].size(); ++j)
+        {
+            u1 += ifSrcW_[i][j] * U[ifSrcCells_[i][j]];
+        }
+        Uib[c] = ifCoeff_[i] * u1;
+    }
+    for (label c = 0; c < mesh_.nCells(); ++c)
+    {
+        if (lambda_[c] >= 1.0) Uib[c] = vector::zero;
+    }
+
+    // ---- fvSource = chi * ( M_h(Uib) + grad(p) ) ---------------------------
+    const volVectorField Mib = UEqnR & Uib;
+    const volVectorField gradP = fvc::grad(p);
+
+    forAll(fvSource, cellI)
+    {
+        if (chi_[cellI] > 0.0)
+        {
+            fvSource[cellI] = Mib[cellI] + gradP[cellI];
+        }
+        else
+        {
+            fvSource[cellI] = vector::zero;
+        }
+    }
+    fvSource.correctBoundaryConditions();
+}
+
+} // End namespace Foam
+
